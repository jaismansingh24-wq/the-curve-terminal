{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Curve Terminal Setup",
  "mainBinaryName": "the-curve-terminal-setup",
  "version": "0.9.4",
  "identifier": "in.thecurve.terminal.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "media-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": false,
    "publisher": "The Curve by s7ven",
    "copyright": "2026 The Curve, by s7ven",
    "shortDescription": "Installs The Curve Terminal",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
